      "expected": { "order": ["r1", "r4", "r2", "r5", "r3"] }
    },
    {
      "name": "the Brand rule carries over from the Feed Item shown just before the page",
      "feed": "for_you",
      "previous_brand": "Northstar",
      "products": {
        "r1": { "title": "One", "brand": "Northstar", "category": "sneakers", "price_minor": 12000 },
        "r2": { "title": "Two", "brand": "Northstar", "category": "sneakers", "price_minor": 12000 },
