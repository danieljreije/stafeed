{
  "format": 1,
  "config": "ranking_config.json",
  "scenarios": [
    {
      "name": "cold start: interests first, then source relevance; For You only takes Ads that ship and are in stock",
      "feed": "for_you",
      "destination_country": "US",
      "interests": ["bags"],
      "products": {
        "a1": { "title": "Air Runner", "brand": "Northstar", "category": "sneakers", "price_minor": 12900 },
        "a2": { "title": "Weekender Duffel", "brand": "Kestrel", "category": "bags", "price_minor": 8900 },
        "a3": { "title": "Court Classic", "brand": "Halden", "category": "sneakers", "price_minor": 9900 },
        "a4": { "title": "City Tote", "brand": "Tidewell", "category": "bags", "price_minor": 6500 },
        "n1": { "title": "Plain Backpack", "brand": "Saltmarsh", "category": "bags", "price_minor": 4500 },
        "u1": { "title": "Sold Out Sling", "brand": "Ferrovia", "category": "bags", "price_minor": 5500 },
        "s1": { "title": "Gulf Trail Boot", "brand": "Quillon", "category": "sneakers", "price_minor": 15900 }
      },
      "candidates": [
        { "id": "a1", "kind": "affiliate_ad", "product": "a1", "relevance": 0.9 },
        { "id": "n1", "kind": "not_an_ad", "product": "n1", "relevance": 0.85 },
        { "id": "a2", "kind": "affiliate_ad", "product": "a2", "relevance": 0.8 },
        { "id": "u1", "kind": "affiliate_ad", "product": "u1", "relevance": 0.95, "available": false },
        { "id": "a3", "kind": "affiliate_ad", "product": "a3", "relevance": 0.7 },
        { "id": "s1", "kind": "affiliate_ad", "product": "s1", "relevance": 0.99, "ships_to": ["AE", "LB"] },
        { "id": "a4", "kind": "affiliate_ad", "product": "a4", "relevance": 0.6 }
      ],
      "expected": { "order": ["a2", "a4", "a1", "a3"] }
    },
    {
      "name": "cold start with no interests and no history keeps the source's order",
      "feed": "for_you",
      "products": {
        "c1": { "title": "One", "brand": "Northstar", "category": "sneakers", "price_minor": 12900 },
        "c2": { "title": "Two", "brand": "Kestrel", "category": "bags", "price_minor": 8900 },
        "c3": { "title": "Three", "brand": "Halden", "category": "watches", "price_minor": 19900 }
      },
      "candidates": [
        { "id": "c1", "kind": "affiliate_ad", "product": "c1", "relevance": 0.9 },
        { "id": "c2", "kind": "affiliate_ad", "product": "c2", "relevance": 0.8 },
        { "id": "c3", "kind": "affiliate_ad", "product": "c3", "relevance": 0.7 }
      ],
      "expected": { "order": ["c1", "c2", "c3"] }
    },
    {
      "name": "Not interested hides the Product for good and ranks its Brand and category lower",
      "feed": "for_you",
      "long_term_signals": [{ "signal": "not_interested", "product": "p1" }],
      "not_interested": ["p1"],
      "products": {
        "p1": { "title": "Air Runner", "brand": "Northstar", "category": "sneakers", "price_minor": 12000 },
        "p2": { "title": "Trail Runner", "brand": "Northstar", "category": "sneakers", "price_minor": 12000 },
        "p3": { "title": "Weekender Duffel", "brand": "Kestrel", "category": "bags", "price_minor": 20000 },
        "p4": { "title": "Field Watch", "brand": "Halden", "category": "watches", "price_minor": 40000 },
        "p5": { "title": "Court Classic", "brand": "Tidewell", "category": "sneakers", "price_minor": 9000 },
        "p6": { "title": "Canvas Pouch", "brand": "Saltmarsh", "category": "bags", "price_minor": 3000 }
      },
      "candidates": [
        { "id": "p1", "kind": "affiliate_ad", "product": "p1", "relevance": 0.9 },
        { "id": "p2", "kind": "affiliate_ad", "product": "p2", "relevance": 0.85 },
        { "id": "p3", "kind": "affiliate_ad", "product": "p3", "relevance": 0.8 },
        { "id": "p4", "kind": "affiliate_ad", "product": "p4", "relevance": 0.75 },
        { "id": "p5", "kind": "affiliate_ad", "product": "p5", "relevance": 0.7 },
        { "id": "p6", "kind": "affiliate_ad", "product": "p6", "relevance": 0.65 },
        { "id": "ba1", "kind": "brand_ad", "brand": "Orbitline", "products": ["p1", "p3"], "relevance": 0.4 },
        { "id": "ba2", "kind": "brand_ad", "brand": "Brightmoor", "products": ["p1"], "relevance": 0.95 }
      ],
      "expected": {
        "order": ["p3", "p4", "p2", "p6", "p5", "ba1"],
        "linked_products": { "ba1": ["p3"] }
      }
    },
    {
      "name": "For You ignores the active Shopping Session's taste",
      "feed": "for_you",
      "session": {
        "signals": [
          { "signal": "save", "product": "q4" },
          { "signal": "share", "product": "q4" },
          { "signal": "save", "product": "q2" }
        ]
      },
      "products": {
        "q1": { "title": "Air Runner", "brand": "Northstar", "category": "sneakers", "price_minor": 12000 },
        "q2": { "title": "Diver", "brand": "Kestrel", "category": "watches", "price_minor": 20000 },
        "q3": { "title": "Court Classic", "brand": "Halden", "category": "sneakers", "price_minor": 9000 },
        "q4": { "title": "Chronograph", "brand": "Quillon", "category": "watches", "price_minor": 40000 }
      },
      "candidates": [
        { "id": "q1", "kind": "affiliate_ad", "product": "q1", "relevance": 0.8 },
        { "id": "q2", "kind": "affiliate_ad", "product": "q2", "relevance": 0.78 },
        { "id": "q3", "kind": "affiliate_ad", "product": "q3", "relevance": 0.76 },
        { "id": "q4", "kind": "affiliate_ad", "product": "q4", "relevance": 0.74 }
      ],
      "expected": { "order": ["q1", "q2", "q3", "q4"] }
    },
    {
      "name": "a Shopping Session's own taste reorders the session feed",
      "feed": "session",
      "session": {
        "signals": [
          { "signal": "save", "product": "q4" },
          { "signal": "share", "product": "q4" },
          { "signal": "save", "product": "q2" }
        ]
      },
      "products": {
        "q1": { "title": "Air Runner", "brand": "Northstar", "category": "sneakers", "price_minor": 12000 },
        "q2": { "title": "Diver", "brand": "Kestrel", "category": "watches", "price_minor": 20000 },
        "q3": { "title": "Court Classic", "brand": "Halden", "category": "sneakers", "price_minor": 9000 },
        "q4": { "title": "Chronograph", "brand": "Quillon", "category": "watches", "price_minor": 40000 }
      },
      "candidates": [
        { "id": "q1", "kind": "affiliate_ad", "product": "q1", "relevance": 0.8 },
        { "id": "q2", "kind": "affiliate_ad", "product": "q2", "relevance": 0.78 },
        { "id": "q3", "kind": "affiliate_ad", "product": "q3", "relevance": 0.76 },
        { "id": "q4", "kind": "affiliate_ad", "product": "q4", "relevance": 0.74 }
      ],
      "expected": { "order": ["q2", "q4", "q1", "q3"] }
    },
    {
      "name": "never the same Brand twice in a row",
      "feed": "for_you",
      "products": {
        "r1": { "title": "One", "brand": "Northstar", "category": "sneakers", "price_minor": 12000 },
        "r2": { "title": "Two", "brand": "Northstar", "category": "sneakers", "price_minor": 12000 },
