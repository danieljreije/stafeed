    {
      "name": "in a Shopping Session a Brand Ad only shows when its Products match the goal",
      "feed": "session",
      "session": { "query": "sneakers" },
      "products": {
        "s1": { "title": "Air Runner", "brand": "Northstar", "category": "sneakers", "price_minor": 12000 },
        "s2": { "title": "Court Classic", "brand": "Kestrel", "category": "sneakers", "price_minor": 9000 },
        "w1": { "title": "Chronograph", "brand": "Quillon", "category": "watches", "price_minor": 40000 },
        "h1": { "title": "Trail Boot", "brand": "Halden", "category": "sneakers", "price_minor": 15000 }
      },
      "candidates": [
        { "id": "s1", "kind": "affiliate_ad", "product": "s1", "relevance": 0.9 },
