    {
      "name": "paid Ads come before Not an Ad on near-ties, but not over a clearly better match",
      "feed": "session",
      "products": {
        "n1": { "title": "Plain Runner", "brand": "Saltmarsh", "category": "sneakers", "price_minor": 9000 },
        "a1": { "title": "Air Runner", "brand": "Northstar", "category": "sneakers", "price_minor": 12000 },
        "n2": { "title": "Best Runner", "brand": "Ferrovia", "category": "sneakers", "price_minor": 11000 },
        "a2": { "title": "Old Runner", "brand": "Kestrel", "category": "sneakers", "price_minor": 7000 }
