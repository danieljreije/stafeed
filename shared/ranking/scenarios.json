      "candidates": [
        { "id": "r1", "kind": "affiliate_ad", "product": "r1", "relevance": 0.9 },
        { "id": "r2", "kind": "affiliate_ad", "product": "r2", "relevance": 0.85 },
        { "id": "r3", "kind": "affiliate_ad", "product": "r3", "relevance": 0.8 },
        { "id": "r4", "kind": "affiliate_ad", "product": "r4", "relevance": 0.7 },
